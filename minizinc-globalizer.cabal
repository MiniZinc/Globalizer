-- Initial minizinc-globalizer.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                minizinc-globalizer
version:             0.1.0.0
synopsis:            Globalizer for MiniZinc
-- description:         
-- license:             
-- license-file:        LICENSE
author:              Chris Mears
maintainer:          chris@cmears.id.au
-- copyright:           
category:            Language
build-type:          Simple
-- extra-source-files:  
cabal-version:       >=1.10
--data-files:          *.mzn
--data-dir:            data-files


executable minizinc-globalizer
  main-is:             Main.hs
  ghc-options:         -O2 -threaded
  -- other-modules:       
  other-extensions:    BangPatterns, DoAndIfThenElse, TemplateHaskell, OverloadedStrings, DeriveDataTypeable, DeriveFunctor, ScopedTypeVariables, GeneralizedNewtypeDeriving, DeriveGeneric, FlexibleContexts, NoMonomorphismRestriction
  other-modules:
                     Arguments
                     Bindings
                     Common
                     EvalModel
                     GroupOutput
                     Loc
                     Misc
                     MiscExp
                     Normalisation
                     Paths_minizinc_globalizer
                     Rewrite
                     SimpleLog
                     Statistics
                     Submodel
                     Transform
                     Types
  build-depends:       aeson >= 0.8.0.2
                     , aeson-pretty >= 0.7.2
                     , async        >=2.0
                     , attoparsec   >=0.12
                     , base         >=4.7
                     , bytestring   >=0.10 && <0.11
                     , cereal       >=0.4
                     , clock        >=0.4
                     , containers   >=0.5 && <0.6
                     , deepseq      >=1.3
                     , directory    >=1.2
                     , exceptions   >=0.6
                     , fgl          >=5.5 && <5.6
                     , global-lock  >=0.1 && <0.2
                     , lens         >=4.4
                     , filepath     >=1.3
                     , lifted-base >= 0.2.3.6
                     , minizinc     >=0.0 && <0.1
                     , monads-tf    >=0.1 && <0.2
                     , optparse-applicative >= 0.11.0.2
                     , parsec       >=3.1 && <3.2
                     , process      >=1.2
                     , random       >=1.1 && <1.2
                     , safe         >=0.3 && <0.4
                     , split >= 0.2.2
                     , stm          >=2.4 && <2.5
                     , temporary    >=1.2 && <1.3
                     , text         >=1.2 && <1.3
                     , time         >=1.4
                     , transformers
                     , uniplate     >=1.6 && <1.7
                     , unix         >=2.7 && <2.8
                     , vector >= 0.10.12.2
  -- hs-source-dirs:      
  default-language:    Haskell2010
