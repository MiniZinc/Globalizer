-- Initial minizinc-globalizer.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                minizinc-globalizer
version:             0.1.6.0
synopsis:            Globalizer for MiniZinc
author:              Chris Mears
maintainer:          kevin.leo@monash.edu
category:            Language
build-type:          Simple
cabal-version:       >=1.10

executable minizinc-globalizer
  hs-source-dirs:    src
  main-is:           Main.hs
  ghc-options:       -O2 -threaded -Wall
  other-extensions:  BangPatterns, DoAndIfThenElse, TemplateHaskell, OverloadedStrings, DeriveDataTypeable, DeriveFunctor, ScopedTypeVariables, GeneralizedNewtypeDeriving, DeriveGeneric, NoMonomorphismRestriction
  other-modules:
                     Arguments
                     Bindings
                     Common
                     EvalModel
                     GroupOutput
                     Loc
                     Misc
                     MiscExp
                     Normalisation
                     Paths_minizinc_globalizer
                     Rewrite
                     SimpleLog
                     Statistics
                     Submodel
                     Transform
                     GlobalizerOptions
                     Types
  build-depends:       aeson >= 0.8.0.2
                     , aeson-pretty >= 0.7.2
                     , async        >=2.0
                     , attoparsec   >=0.12
                     , base         >=4.7
                     , bytestring   >=0.10 && <0.11
                     , cereal       >=0.4
                     , clock        >=0.4
                     , containers   >=0.5 && <0.6
                     , exceptions   >=0.6
                     , fgl          >=5.5 && <5.6
                     , lens         >=4.4
                     , lifted-base >= 0.2.3.6
                     , minizinc     >=0.0 && <0.1
                     , monads-tf    >=0.1 && <0.2
                     , optparse-applicative >= 0.11.0.2
                     , process      >=1.2
                     , random       >=1.1 && <1.2
                     , safe         >=0.3 && <0.4
                     , stm          >=2.4 && <2.5
                     , temporary    >=1.2 && <1.3
                     , text         >=1.2 && <1.3
                     , time         >=1.4
                     , uniplate     >=1.6 && <1.7
                     , vector >= 0.10.12.2
  default-language:    Haskell2010
